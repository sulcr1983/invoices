# ==========================================
# SuperSu 发票处理系统 - 配置文件模板
# 复制此文件为 .env 并填写你的配置
# 所有外部能力都是可选的：不填就自动降级，不影响主流程
# ==========================================

# -------- 百度 OCR 配置（可选）--------
# 不配置时：OFD 直接解析 XML、带文本层的 PDF 走本地提取、
# 扫描件/图片回落到本地 RapidOCR（离线），系统仍可正常使用。
# 在百度AI平台创建应用后获取：
# https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
# OCR 类型，默认增值税发票
BAIDU_OCR_TYPE=vat_invoice

# -------- 发票验真配置（可选）--------
# 验真功能开关（true/false）
VERIFY_ENABLED=true
# 每次验真调用费用（元），用于前端费用提示
VERIFY_COST_PER_CALL=0.25

# -------- 企业微信 Webhook 配置（可选）--------
# 不配置时：推送状态记为 skipped（不再伪造成 success）
WECOM_WEBHOOK_URL=
# Webhook 的 schema 配置（JSON 格式，定义字段映射）
WECOM_SCHEMA={}
# 告警推送（当前版本预留，未接入实际发送逻辑）
ENABLE_ALERT=false
ALERT_WEBHOOK_URL=

# -------- 系统配置（可选）--------
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志轮转：单文件上限（字节）与保留份数
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3
# 数据库超时时间（秒）
SQLITE_TIMEOUT=20
# HTTP 请求超时时间（秒）
REQUEST_TIMEOUT=10
# 失败重试次数与间隔
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY_SECONDS=2

# -------- 部署（可选）--------
# 便携包使用：指定项目根目录（留空则自动检测）
INVOICE_PROJECT_ROOT=
# 监听地址：默认仅本机；容器/局域网改成 0.0.0.0
INVOICE_HOST=127.0.0.1
INVOICE_PORT=5000
